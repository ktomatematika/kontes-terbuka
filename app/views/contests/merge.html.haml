.container
  %h2 Merge Kontes

  = form_tag(request.original_url, method: :get) do
    .form-group
      = label_tag :contest_id, 'Kontes Asal'
      = select_tag :contest_id,
        options_for_select(Contest.order(id: :desc).pluck(:name, :id), params[:contest_id]),
        class: 'form-control'
    .form-group
      = label_tag :problem_no, 'Problem no. asal'
      = text_field_tag :problem_no, params[:problem_no], class: 'form-control'
    .form-group
      = label_tag :contest_id, 'Kontes Tujuan'
      = select_tag :contest_id,
        options_for_select(Contest.order(id: :desc).pluck(:name, :id), params[:contest_id]),
        class: 'form-control'
    .form-group
      = label_tag :problem_no, 'Problem no. tujuan'
      = text_field_tag :problem_no, params[:problem_no], class: 'form-control'
    = submit_tag 'Submit', class: 'btn'

